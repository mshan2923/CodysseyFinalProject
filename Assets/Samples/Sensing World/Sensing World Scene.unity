  m_BlackboardVariableOverridesList:
  - rid: 6453904991753077223
  - rid: 6453904991753077405
  m_OriginalGraph: {fileID: 750395920257023565, guid: e86a21f5dd46c124494679986ad6a5c1, type: 2}
  m_IsInitialised: 0
  m_IsStarted: 0
  references:
    version: 2
    RefIds:
    - rid: 6453904991753077223
      type: {class: 'BlackboardVariable`1[[UnityEngine.GameObject, UnityEngine.CoreModule]]', ns: Unity.Behavior, asm: Unity.Behavior}
      data:
        GUID:
          m_Value0: 1
          m_Value1: 0
        Name: Self
        m_Value: {fileID: 298353815}
    - rid: 6453904991753077405
      type: {class: 'BlackboardVariable`1[[System.String, mscorlib]]', ns: Unity.Behavior, asm: Unity.Behavior}
      data:
        GUID:
          m_Value0: 6339016722272072363
          m_Value1: 1099826825360465190
        Name: SystemPrompt
        m_Value: 'You are an NPC interpreting game sensor data and time-ordered events.
          This is not a camera image, so never claim to see the game screen directly. 
          Use only the objects, InstanceIDs, states, distances, directions, interaction
          scores, current world state, and recent events provided in the message. 
          Hit means only that two objects collided. It does not directly mean an
          attack, intention, or damage.  Use the order of recent events and the current
          world state to interpret possible situations. For example, if the Player
          picked up an object, dropped it, and that object later hit an NPC, you
          may infer that the Player may have thrown the object. Express this only
          as a possibility, never as a confirmed intention.  When mentioning a target,
          always use its exact provided name and InstanceID in this format: Name
          (InstanceID: number).  Do not invent objects, states, actions, intentions,
          visibility, or relationships. Do not output JSON, Markdown, code fences,
          lists, or analysis.  Return exactly one natural Korean sentence describing
          the most meaningful current situation or possible interaction.'
