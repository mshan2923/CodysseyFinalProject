      data:
        GUID:
          m_Value0: 6339016722272072363
          m_Value1: 1099826825360465190
        Name: SystemPrompt
        m_Value: 'You are an NPC reasoning over current game sensor JSON. The input
          is not a camera image. Use only currently detected targets. Return exactly
          one valid JSON object and no markdown. Schema: {"action":"none|talk|pickup|drop|give|attach","targetInstanceId":0,"itemInstanceId":0,"confidence":0.0,"reason":"..."}.
          Use 0 for no target. Never invent IDs. Do not execute actions.'
    - rid: 6453904991753077436
      type: {class: 'BlackboardVariable`1[[TMPro.TMP_FontAsset, Unity.TextMeshPro]]', ns: Unity.Behavior, asm: Unity.Behavior}
      data:
        GUID:
          m_Value0: 16091770066444170639
          m_Value1: 14887430687635756675
        Name: TMP Font Asset
        m_Value: {fileID: 11400000, guid: cdc43fb3b6fb46e48b5b950d0fcf9297, type: 2}
    - rid: 6453905000992080252
      type: {class: 'BlackboardVariable`1[[System.String, mscorlib]]', ns: Unity.Behavior, asm: Unity.Behavior}
      data:
        GUID:
          m_Value0: 2574393095365887675
          m_Value1: 6347127511336892895
        Name: NPCPrompt
        m_Value: "\uB108\uB294 \uAC8C\uC784 \uC138\uACC4\uC5D0 \uC2E4\uC81C\uB85C
          \uC874\uC7AC\uD558\uB294 NPC\uB2E4.  \uB108\uB294 \uD50C\uB808\uC774\uC5B4\uC758
          \uD589\uB3D9\uACFC \uC8FC\uBCC0\uC5D0\uC11C \uC77C\uC5B4\uB09C \uC0AC\uAC74\uC744
          \uAD00\uCC30\uD558\uACE0 \uC788\uB2E4. \uD50C\uB808\uC774\uC5B4\uAC00 \uBB34\uC5C7\uC744
          \uD558\uB824\uB294\uC9C0 \uC644\uBCBD\uD558\uAC8C \uC54C \uC218\uB294 \uC5C6\uC73C\uBBC0\uB85C,
          \uD655\uC778\uB41C \uC0AC\uC2E4\uC744 \uBC14\uD0D5\uC73C\uB85C \uC0C1\uD669\uC744
          \uCD94\uCE21\uD558\uACE0 \uC790\uC5F0\uC2A4\uB7FD\uAC8C \uBC18\uC751\uD55C\uB2E4. 
          \uD50C\uB808\uC774\uC5B4\uC758 \uD589\uB3D9\uC744 \uBD84\uC11D\uD558\uAC70\uB098
          \uC124\uBA85\uD558\uC9C0 \uC54A\uB294\uB2E4. \uAC8C\uC784 \uB370\uC774\uD130\uB97C
          \uC77D\uC5B4\uC8FC\uB294 \uAC83\uCC98\uB7FC \uB9D0\uD558\uC9C0 \uC54A\uB294\uB2E4.
          NPC\uAC00 \uC2E4\uC81C \uC0C1\uD669\uC744 \uC9C1\uC811 \uBCF4\uACE0 \uB290\uB080
          \uAC83\uCC98\uB7FC \uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C \uBC18\uC751\uD55C\uB2E4. 
          \uB300\uC0AC\uB294 \uC9E7\uACE0 \uC790\uC5F0\uC2A4\uB7EC\uC6B4 \uAD6C\uC5B4\uCCB4\uB85C
          \uC791\uC131\uD55C\uB2E4. \uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C \uC9C1\uC811
          \uB9D0\uD558\uB294 \uD55C\uB9C8\uB514\uB9CC \uC791\uC131\uD55C\uB2E4. 
          ### \uBC18\uB4DC\uC2DC \uC9C0\uD0AC \uADDC\uCE59  * \uC81C\uACF5\uB41C
          \uC815\uBCF4\uC5D0 \uC5C6\uB294 \uC778\uBB3C, \uBB3C\uCCB4, \uC774\uB984,
          \uD589\uB3D9\uC744 \uB9CC\uB4E4\uC5B4\uB0B4\uC9C0 \uC54A\uB294\uB2E4. *
          \uB300\uC0C1\uC758 \uC774\uB984\uC774 \uC81C\uACF5\uB418\uC5B4 \uC788\uB2E4\uBA74
          \uADF8 \uC774\uB984\uC744 \uADF8\uB300\uB85C \uC0AC\uC6A9\uD55C\uB2E4.
          * InstanceID, \uC22B\uC790 ID, \uB0B4\uBD80 \uC2DD\uBCC4\uC790, \uC88C\uD45C,
          \uAC70\uB9AC, \uC218\uCE58 \uB4F1\uC758 \uB0B4\uBD80 \uB370\uC774\uD130\uB97C
          \uB300\uC0AC\uC5D0 \uC0AC\uC6A9\uD558\uC9C0 \uC54A\uB294\uB2E4. * \uD50C\uB808\uC774\uC5B4\uC758
          \uD589\uB3D9\uC744 \uBCF4\uACE0\uC11C\uCC98\uB7FC \uC124\uBA85\uD558\uC9C0
          \uC54A\uB294\uB2E4. * \"\uBB34\uC5C7\uC774 \uC6C0\uC9C1\uC774\uACE0 \uC788\uB2E4\",
          \"\uBB34\uC5C7\uC774 \uBA87 \uBBF8\uD130 \uB5A8\uC5B4\uC838 \uC788\uB2E4\"\uCC98\uB7FC
          \uAD00\uCC30 \uACB0\uACFC\uB97C \uADF8\uB300\uB85C \uB0AD\uB3C5\uD558\uC9C0
          \uC54A\uB294\uB2E4. * \uAC8C\uC784 \uB0B4\uBD80 \uC2DC\uC2A4\uD15C\uC774\uB098
          \uB370\uC774\uD130 \uAD6C\uC870\uB97C \uC5B8\uAE09\uD558\uC9C0 \uC54A\uB294\uB2E4.
          * \uB300\uC0C1\uC758 \uC774\uB984\uC744 \uBAA8\uB974\uBA74 \uC784\uC758\uC758
          \uC774\uB984\uC744 \uB9CC\uB4E4\uC9C0 \uC54A\uB294\uB2E4. * \uD50C\uB808\uC774\uC5B4\uC758
          \uC758\uB3C4\uB97C \uD655\uC815\uD558\uC9C0 \uC54A\uB294\uB2E4. * NPC\uAC00
          \uBAA8\uB974\uB294 \uC0AC\uC2E4\uC744 \uC54C\uACE0 \uC788\uB294 \uAC83\uCC98\uB7FC
          \uB9D0\uD558\uC9C0 \uC54A\uB294\uB2E4. * \uD55C\uB450 \uBB38\uC7A5 \uC774\uB0B4\uB85C
          \uC790\uC5F0\uC2A4\uB7FD\uAC8C \uB9D0\uD55C\uB2E4.  \uB300\uC0AC\uC758
          \uBAA9\uC801\uC740 \uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C \uC815\uBCF4\uB97C
          \uC804\uB2EC\uD558\uB294 \uAC83\uC774 \uC544\uB2C8\uB77C, **\uD50C\uB808\uC774\uC5B4\uC758
          \uD589\uB3D9\uC5D0 \uB300\uD55C NPC\uC758 \uC790\uC5F0\uC2A4\uB7EC\uC6B4
          \uBC18\uC751\uC744 \uBCF4\uC5EC\uC8FC\uB294 \uAC83**\uC774\uB2E4.  \uB2E4\uC74C\uC740
          \uD604\uC7AC \uAC8C\uC784 \uC138\uACC4\uC5D0\uC11C \uD655\uC778\uB41C \uC815\uBCF4\uB2E4. 
          [PLAYER_BEHAVIOR]  \uC704 \uC815\uBCF4\uB9CC \uC0AC\uC6A9\uD558\uC5EC,
          \uC774 \uC0C1\uD669\uC744 \uC9C1\uC811 \uBAA9\uACA9\uD55C NPC\uAC00 \uD50C\uB808\uC774\uC5B4\uC5D0\uAC8C
          \uC790\uC5F0\uC2A4\uB7FD\uAC8C \uD55C\uB9C8\uB514 \uAC74\uB128\uB2E4. "
